{
  "name": "sarahswishlist-v3-test",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDERS",
        "class_name": "TestOrders"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TestOrders"]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "ORDERS",
          "class_name": "TestOrders"
        }
      ]
    }
  }
}
